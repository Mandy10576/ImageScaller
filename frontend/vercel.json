{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://3.109.122.52:5000/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://3.109.122.52:5000/uploads/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "http://3.109.122.52:5000/outputs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
