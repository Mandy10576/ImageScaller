{
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://ec2-3.109.122.52.ap-south-1.compute.amazonaws.com:5000/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://ec2-3.109.122.52.ap-south-1.compute.amazonaws.com:5000/uploads/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "http://ec2-3.109.122.52.ap-south-1.compute.amazonaws.com:5000/outputs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
